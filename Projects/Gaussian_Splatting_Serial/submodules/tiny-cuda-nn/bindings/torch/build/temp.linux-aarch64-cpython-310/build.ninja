ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda-13.0/bin/nvcc

cflags = -pthread -B /home/mta188/miniconda3/envs/gs/compiler_compat -Wno-unused-result -Wsign-compare -DNDEBUG -fwrapv -O3 -Wall -fPIC -O3 -isystem /home/mta188/miniconda3/envs/gs/include -fPIC -O3 -isystem /home/mta188/miniconda3/envs/gs/include -fPIC -I/home/mta188/gaussian-splatting/submodules/tiny-cuda-nn/include -I/home/mta188/gaussian-splatting/submodules/tiny-cuda-nn/dependencies -I/home/mta188/gaussian-splatting/submodules/tiny-cuda-nn/dependencies/cutlass/include -I/home/mta188/gaussian-splatting/submodules/tiny-cuda-nn/dependencies/cutlass/tools/util/include -I/home/mta188/gaussian-splatting/submodules/tiny-cuda-nn/dependencies/fmt/include -I/home/mta188/miniconda3/envs/gs/lib/python3.10/site-packages/torch/include -I/home/mta188/miniconda3/envs/gs/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/usr/local/cuda-13.0/include -I/home/mta188/miniconda3/envs/gs/include/python3.10 -c
post_cflags = -std=c++17 -DTCNN_PARAMS_UNALIGNED -DTCNN_RTC -DTCNN_RTC_USE_FAST_MATH -DTCNN_MIN_GPU_ARCH=110 -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=_110_C
cuda_cflags = -I/home/mta188/gaussian-splatting/submodules/tiny-cuda-nn/include -I/home/mta188/gaussian-splatting/submodules/tiny-cuda-nn/dependencies -I/home/mta188/gaussian-splatting/submodules/tiny-cuda-nn/dependencies/cutlass/include -I/home/mta188/gaussian-splatting/submodules/tiny-cuda-nn/dependencies/cutlass/tools/util/include -I/home/mta188/gaussian-splatting/submodules/tiny-cuda-nn/dependencies/fmt/include -I/home/mta188/miniconda3/envs/gs/lib/python3.10/site-packages/torch/include -I/home/mta188/miniconda3/envs/gs/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/usr/local/cuda-13.0/include -I/home/mta188/miniconda3/envs/gs/include/python3.10 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -std=c++17 --extended-lambda --use_fast_math --expt-relaxed-constexpr -U__CUDA_NO_HALF_OPERATORS__ -U__CUDA_NO_HALF_CONVERSIONS__ -U__CUDA_NO_HALF2_OPERATORS__ -Xcompiler=-Wno-float-conversion -Xcompiler=-fno-strict-aliasing -gencode=arch=compute_110,code=compute_110 -gencode=arch=compute_110,code=sm_110 -DTCNN_PARAMS_UNALIGNED -DTCNN_RTC -DTCNN_RTC_USE_FAST_MATH -DTCNN_MIN_GPU_ARCH=110 -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=_110_C
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags







